# ReportBeacon API — environment. Copy to .env for local dev; set these in
# Railway's service variables in production.

# Port the server listens on. Railway sets PORT automatically; 8080 for local.
PORT=8080

# Postgres. Railway injects DATABASE_URL when you attach a Postgres plugin.
# Leave unset locally and the API still boots (health reports "unconfigured",
# and auth returns 503 until a database is attached).
# DATABASE_URL=postgresql://user:pass@host:5432/reportbeacon

# Where the frontend and this API live. Used for the magic-link callback and
# the post-login redirect. Localhost defaults are fine for dev.
APP_URL=http://localhost:5173
API_URL=http://localhost:8080

# Comma-separated allowed browser origins (credentialed). Empty = reflect any
# origin (dev only). In production list the app origin(s).
# CORS_ORIGINS=https://demo.tinashebenson.com,https://app.tinashebenson.com

# Host suffixes whose subdomains are also allowed, so every subdomain of a site
# you own does not need listing. ONLY use domains you control: a shared suffix
# like .vercel.app would let any site hosted there make credentialed calls to
# this API with a signed-in user's cookie.
# CORS_ORIGIN_SUFFIXES=.tinashebenson.com

# Session cookie domain. Leave unset locally (host-only cookie on localhost).
# In production set to the shared parent so app + api share it.
# COOKIE_DOMAIN=.tinashebenson.com

# Email (magic link). Without RESEND_API_KEY the link is logged to the server
# console (dev). Set both in production.
# RESEND_API_KEY=
# EMAIL_FROM=ReportBeacon <login@tinashebenson.com>

# Encryption for platform access tokens at rest (AES-256-GCM). 32 bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production; dev falls back to a fixed key with a warning.
# TOKEN_ENC_KEY=
# Secret that signs the OAuth `state` parameter (CSRF). Defaults to TOKEN_ENC_KEY.
# OAUTH_STATE_SECRET=

# Meta (Facebook + Instagram) app. Without these the connect flow runs in a
# stub that imports sample accounts, so the pipeline is testable before the app
# exists. Set all three to go live.
# META_APP_ID=
# META_APP_SECRET=
# META_REDIRECT_URI=https://api.tinashebenson.com/api/connect/meta/callback

# Facebook Login for Business "configuration id". Meta has two login products:
# classic Facebook Login takes a scope list in the dialog URL, while Facebook
# Login for Business — which is what a Business-type app gets — takes a
# config_id, with the permissions chosen in the App Dashboard instead. Set this
# when the app uses Facebook Login for Business; leave unset for classic.
# META_LOGIN_CONFIG_ID=

# Two dashboard settings the server cannot check for you, and they are separate
# gates — passing one does not satisfy the other:
#   1. App settings → Basic → App Domains must list the API's host
#      (api.tinashebenson.com). Listing the parent domain does NOT cover
#      subdomains; each one must appear in its own right.
#   2. The login product's settings must list META_REDIRECT_URI verbatim under
#      Valid OAuth Redirect URIs, with Client OAuth Login and Web OAuth Login
#      both enabled.

# Graph API version used for every Meta call. Insights metric names change
# between versions — Instagram retired `impressions` in favour of `views` in
# v22.0, and Page `page_impressions` / `page_fans` were retired through late
# 2025 — so the pull asks for candidate metric names and keeps whichever this
# version still serves. Bump this when Meta sunsets the pinned version; check
# /api/social/sync-runs afterwards to see which metrics answered.
# META_GRAPH_VERSION=v23.0

# ── LinkedIn (organization pages) ────────────────────────────────────────────
# LinkedIn's Community Management API is a VETTED product: these credentials are
# necessary but not sufficient. The app must be approved by LinkedIn (Development
# Tier first, then Standard) before the statistics endpoints return anything, and
# there is no development mode to try it in beforehand.
#
# Two constraints worth knowing before you apply:
#  - Only company pages where the connecting member is an ADMINISTRATOR can be
#    connected. Analyst access is not enough.
#  - Personal profile analytics are impossible: r_member_social is a closed
#    permission LinkedIn is not granting.
#
# Request Development Tier with a NEW app that has no other API products on it —
# the option is greyed out otherwise.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI=https://api.tinashebenson.com/api/connect/linkedin/callback

# Marketing API version, YYYYMM. LinkedIn sunsets versions on a schedule (202510
# goes on 15 October 2026), so this is configurable for the same reason
# META_GRAPH_VERSION is.
# LINKEDIN_VERSION=202609
